# Copy to .env and fill in local values. Do not commit real secrets.

# GA4
GA4_PROPERTY_ID=123456789
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
GA4_API_TRANSPORT=rest

# Optional Feishu / Lark Base sync. Not required for the GitHub-first flow.
LARK_CLI_PROFILE=rebecca-agent
LARK_BASE_TOKEN=
LARK_BASE_TABLE_ID=
LARK_BASE_DASHBOARD_ID=

# Pipeline defaults
PIPELINE_CONFIG=config/pipeline.json
PIPELINE_LOOKBACK_DAYS=28
