# Copy to .env and fill in. Do not commit real secrets.

# GA4 auth (local: adc / CI: service_account)
GA4_AUTH_MODE=adc
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json  # CI only

# Feishu Bitable sync (weekly)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
# 仅供旧版 scripts/sync_feishu.py 使用；新版按表名自动发现，无需配置
FEISHU_BITABLE_TABLE_ID=
